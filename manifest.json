        { "id": 5, "kind": "ws", "label": "🟠", "font": "Noto Color Emoji", "fontPx": 14, "specialName": "", "title": "" },
        { "id": 6, "kind": "ws", "label": "🟣", "font": "Noto Color Emoji", "fontPx": 14, "specialName": "", "title": "" },
